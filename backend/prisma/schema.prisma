// =============================================================
//  FAB Seafood - Prisma schema
//  Tài liệu: docs/03-database-prisma.md
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum Role {
  CUSTOMER
  STAFF // Nhân viên: quyền theo vai trò (staffRole) trong ma trận phân quyền
  ADMIN // Toàn quyền
}

enum OrderType {
  DELIVERY // Giao tận nơi
  PICKUP // Đến lấy
  DINE_IN // Ăn tại quán: nhân viên phục vụ ghi món tại bàn bằng app mobile. Tài liệu: docs/23-app-nhan-vien-phuc-vu.md
}

enum OrderStatus {
  PENDING // Chờ xác nhận
  CONFIRMED // Đã xác nhận
  PREPARING // Đang chế biến
  DELIVERING // Đang giao
  COMPLETED // Hoàn thành
  CANCELLED // Đã hủy
}

// Trạng thái từng món của đơn ăn tại quán (đơn online không dùng). Tài liệu: docs/23-app-nhan-vien-phuc-vu.md
// Hủy món: PENDING hủy luôn; COOKING / SERVED (bếp đã làm) phải ghi lý do
enum OrderItemStatus {
  WEIGHING // Món bán theo kg (hải sản sống): chờ nhân viên hồ hải sản cân, cân xong mới tính tiền và sang bếp
  PENDING // Đã gửi bếp, bếp chưa làm
  COOKING // Bếp đang làm (bếp bấm "Nhận làm" ở trang Phiếu bếp)
  SERVED // Phục vụ đã mang ra bàn ("Check món")
  CANCELLED // Đã hủy
}

enum PaymentMethod {
  COD // Thanh toán khi nhận hàng
  ONLINE // Thanh toán online (mô phỏng)
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

// Kết quả 1 lần thanh toán qua cổng (VNPay)
enum PaymentTxnStatus {
  PENDING // Đã tạo link, khách chưa trả xong
  SUCCESS // Cổng thanh toán báo thành công
  FAILED // Khách hủy / thẻ lỗi / hết hạn
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum CouponType {
  PERCENT // Giảm theo %
  FIXED // Giảm số tiền cố định
}

// Việc vệ sinh của tạp vụ. Tài liệu: docs/20-ve-sinh.md
enum CleaningStatus {
  TODO // Chờ làm
  IN_PROGRESS // Đang làm
  DONE // Đã xong -> hiện ở Lịch sử công việc
  CANCELLED // Đã hủy (giao nhầm, không cần làm nữa)
}

enum CleaningPriority {
  NORMAL // Bình thường
  URGENT // Gấp: xếp lên đầu danh sách, tô đỏ
}

// Phiếu sửa chữa của nhân viên kỹ thuật. Tài liệu: docs/22-ky-thuat-bao-tri.md
enum RepairStatus {
  OPEN // Mới báo, chưa ai nhận
  IN_PROGRESS // Đang sửa
  WAITING_PARTS // Chờ linh kiện / chờ thợ bên ngoài
  DONE // Đã sửa xong -> hiện ở Lịch sử sửa chữa
  CANCELLED // Hủy (báo nhầm, không cần sửa)
}

enum RepairType {
  REPAIR // Sửa sự cố (có người báo hỏng)
  MAINTENANCE // Bảo trì định kỳ (kỹ thuật bấm "Đã bảo trì")
}

enum RepairPriority {
  NORMAL // Bình thường
  URGENT // Gấp: ảnh hưởng phục vụ khách / an toàn (vd tủ đông không lạnh, máy sục khí hồ ngừng)
}

// ---------- MODELS ----------

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  phone        String?
  passwordHash String
  role         Role          @default(CUSTOMER)
  address      String?
  avatar       String?
  isActive     Boolean       @default(true)
  staffRoleId  Int? // Chỉ dùng khi role = STAFF
  staffRole    StaffRole?    @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       Order[]       @relation("OrderCustomer")
  reservations Reservation[]
  reviews      Review[]

  ordersServed Order[] @relation("OrderStaff") // Đơn ăn tại quán người này mở (nhân viên phục vụ)

  cleaningAssigned CleaningTask[]           @relation("CleaningAssignee") // Việc vệ sinh được giao / đã làm
  cleaningCreated  CleaningTask[]           @relation("CleaningCreator") // Việc vệ sinh người này tạo / báo
  tableChanges     ReservationTableChange[] // Các lần nhân viên này chuyển bàn cho khách
  repairsReported  RepairTicket[]           @relation("RepairReporter") // Phiếu sửa chữa người này báo
  repairsAssigned  RepairTicket[]           @relation("RepairAssignee") // Phiếu sửa chữa người này nhận / đã sửa
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  image       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  dishes      Dish[]
}

model Dish {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  description String?
  price       Int // Giá gốc (VNĐ)
  salePrice   Int? // Giá khuyến mãi (nếu có)
  unit        String      @default("phần") // phần, đĩa, kg, ly...
  image       String?
  isAvailable Boolean     @default(true)
  isFeatured  Boolean     @default(false)
  soldCount   Int         @default(0)
  ratingAvg   Float       @default(0)
  ratingCount Int         @default(0)
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  reviews     Review[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
}

model Order {
  id              Int           @id @default(autoincrement())
  code            String        @unique // Mã đơn hiển thị cho khách, vd: FAB2410011234
  userId          Int?
  user            User?         @relation("OrderCustomer", fields: [userId], references: [id])
  customerName    String
  phone           String // Đơn ăn tại quán (nhân viên ghi món): để trống
  address         String?
  tableId         Int? // Đơn ăn tại quán (DINE_IN): bàn của khách
  table           DiningTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  staffId         Int? // Đơn ăn tại quán: nhân viên mở đơn
  staff           User?         @relation("OrderStaff", fields: [staffId], references: [id], onDelete: SetNull)
  type            OrderType     @default(DELIVERY)
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Int
  discount        Int           @default(0)
  shippingFee     Int           @default(0)
  total           Int
  couponCode      String?
  note            String?
  cancelReason    String? // Lý do nhà hàng hủy đơn, khách xem được. Trống = khách tự hủy (hoặc đơn chưa hủy)
  billRequestedAt DateTime? // Đơn tại quán: phục vụ bấm "Gửi thanh toán" -> thu ngân nhận thông báo. Gọi thêm món thì xóa
  billPrintedAt   DateTime? // Đơn tại quán: thu ngân in bill lần gần nhất
  items           OrderItem[]
  payments        Payment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([tableId, status])
}

// Lưu lại tên + giá tại thời điểm đặt để lịch sử đơn không bị đổi khi món thay giá
model OrderItem {
  id           Int             @id @default(autoincrement())
  orderId      Int
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId       Int
  dish         Dish            @relation(fields: [dishId], references: [id])
  name         String
  price        Int
  quantity     Int
  note         String? // Ghi chú khẩu vị riêng của món, vd "2 phần ít cay, 1 phần không hành"
  createdAt    DateTime        @default(now()) // Đơn ăn tại quán: mỗi lần gọi thêm là các dòng mới, biết món nào gọi lúc nào
  // ---- Chỉ dùng cho đơn ăn tại quán ----
  status       OrderItemStatus @default(PENDING)
  servedAt     DateTime? // Lúc phục vụ check món (mang ra bàn)
  cancelReason String? // Lý do hủy món (bắt buộc khi bếp đã làm)
  cancelledAt  DateTime?
  // ---- Món bán theo kg (hải sản sống ở hồ), docs/24-thuc-don-ban-theo-kg.md ----
  weight       Float? // Số kg thực tế nhân viên hồ hải sản cân. Tiền dòng = price (giá 1 kg) × weight. null = món theo phần / chưa cân
  weighedAt    DateTime? // Lúc cân

  @@index([orderId, status])
}

// Mỗi lần khách bấm "Thanh toán" = 1 dòng Payment (1 đơn có thể thử trả nhiều lần).
// Lưu lại để đối soát với VNPay khi có khiếu nại: mã giao dịch, ngân hàng, mã phản hồi...
model Payment {
  id            Int              @id @default(autoincrement())
  orderId       Int
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String           @default("VNPAY")
  txnRef        String           @unique // Mã giao dịch mình gửi sang VNPay (vnp_TxnRef)
  amount        Int // Số tiền (VNĐ) tại thời điểm tạo link
  status        PaymentTxnStatus @default(PENDING)
  transactionNo String? // Mã giao dịch phía VNPay (vnp_TransactionNo)
  bankCode      String?
  responseCode  String? // vnp_ResponseCode: "00" = thành công
  paidAt        DateTime?
  rawData       Json? // Toàn bộ dữ liệu VNPay gửi về
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([orderId])
}

model Reservation {
  id           Int                      @id @default(autoincrement())
  code         String                   @unique
  userId       Int?
  user         User?                    @relation(fields: [userId], references: [id])
  name         String
  phone        String
  email        String?
  date         DateTime // Ngày giờ đến
  guests       Int
  area         String? // Khu vực mong muốn: trong nhà, ngoài trời, phòng VIP
  tableId      Int? // Bàn khách chọn trên sơ đồ (không bắt buộc)
  table        DiningTable?             @relation(fields: [tableId], references: [id], onDelete: SetNull)
  note         String?
  status       ReservationStatus        @default(PENDING)
  cancelReason String? // Lý do nhà hàng hủy lịch, hiện cho khách xem để đặt lại giờ khác
  tableChanges ReservationTableChange[] // Lịch sử chuyển bàn (lễ tân)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([date])
  @@index([tableId, date])
}

// 1 lần lễ tân chuyển bàn / xếp bàn cho 1 lịch đặt. Tài liệu: docs/21-le-tan-chuyen-ban.md
// Lưu MÃ bàn dạng chữ (giống OrderItem lưu tên món) để lịch sử vẫn đọc được khi bàn bị đổi / xóa.
model ReservationTableChange {
  id            Int         @id @default(autoincrement())
  reservationId Int
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fromTableCode String? // Bàn cũ, trống = lịch chưa có bàn (lần "xếp bàn" đầu tiên)
  fromArea      String?
  toTableCode   String // Bàn mới
  toArea        String
  reason        String? // vd "Khách muốn ngồi view biển"
  changedById   Int?
  changedBy     User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([reservationId])
}

// Bàn trong nhà hàng, vẽ thành sơ đồ theo khu vực. Bàn mặc định: src/config/tables.js
// Tài liệu: docs/13-so-do-ban.md
model DiningTable {
  id           Int           @id @default(autoincrement())
  code         String        @unique // Số bàn hiển thị, vd: T01, BIEN03, VIP1
  area         String // Khớp 1 trong restaurant.reservationAreas
  seats        Int // Số ghế tối đa
  x            Int // Cột trên sơ đồ (bắt đầu từ 1)
  y            Int // Hàng trên sơ đồ (bắt đầu từ 1)
  isActive     Boolean       @default(true) // Tắt khi bàn hỏng / đang sửa
  reservations Reservation[]
  orders       Order[] // Đơn ăn tại quán của bàn
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dishId    Int
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  rating    Int // 1..5
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, dishId]) // Mỗi người chỉ đánh giá 1 lần / món
}

model Coupon {
  id          Int        @id @default(autoincrement())
  code        String     @unique
  description String?
  type        CouponType
  value       Int // % hoặc số tiền
  minOrder    Int        @default(0)
  maxDiscount Int? // Giảm tối đa (dùng cho PERCENT)
  usageLimit  Int? // null = không giới hạn
  usedCount   Int        @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
}

// ---------- PHÂN QUYỀN NỘI BỘ (ma trận vai trò × chức năng) ----------
// Danh sách chức năng (module) cố định nằm trong src/config/permissions.js.
// Tài liệu: docs/12-ma-tran-phan-quyen.md

// Vai trò / bộ phận trong nhà hàng: Chủ, Quản lý, Bếp, Thu ngân...
model StaffRole {
  id          Int              @id @default(autoincrement())
  key         String           @unique // Mã viết hoa, vd: CASHIER
  name        String // Tên hiển thị, vd: Thu ngân
  description String? // Bộ phận này làm gì
  sortOrder   Int              @default(0)
  isSystem    Boolean          @default(false) // Vai trò mặc định -> không cho xóa
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// 1 dòng = quyền của 1 vai trò trên 1 chức năng: Xem / Thêm / Sửa / Xóa
model RolePermission {
  id        Int       @id @default(autoincrement())
  roleId    Int
  role      StaffRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    String // Mã chức năng, vd: ORDERS (xem MODULES trong config/permissions.js)
  canView   Boolean   @default(false)
  canCreate Boolean   @default(false)
  canEdit   Boolean   @default(false)
  canDelete Boolean   @default(false)

  @@unique([roleId, module])
}

// ---------- VỆ SINH (việc của tạp vụ) ----------
// Tài liệu: docs/20-ve-sinh.md. Khu vực mặc định: src/config/cleaning.js
// "Khu vực cần dọn" = khu đang có việc chưa xong; "Lịch sử công việc" = việc đã xong.
// Cả hai lấy từ bảng CleaningTask nên không bao giờ lệch nhau.

// Khu vực tạp vụ phụ trách: nhà vệ sinh, khu rửa chén bát, quầy rửa ly, sảnh...
model CleaningArea {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  description   String? // Việc thường làm ở khu này, vd "Lau sàn, lau gương, thay giấy"
  sortOrder     Int            @default(0)
  isActive      Boolean        @default(true) // Tắt = ẩn khỏi danh sách (vd khu đang sửa chữa)
  lastCleanedAt DateTime? // Lần gần nhất có việc ở khu này được làm xong
  tasks         CleaningTask[]
  createdAt     DateTime       @default(now())
}

// 1 việc vệ sinh: quản lý giao, tạp vụ tự thêm, hoặc phục vụ / lễ tân báo "cần dọn"
model CleaningTask {
  id          Int              @id @default(autoincrement())
  title       String // vd "Rửa chén bát ca trưa", "Nhà vệ sinh nữ hết giấy"
  note        String? // Mô tả thêm lúc tạo
  areaId      Int
  area        CleaningArea     @relation(fields: [areaId], references: [id])
  priority    CleaningPriority @default(NORMAL)
  status      CleaningStatus   @default(TODO)
  assigneeId  Int? // Người được giao / người nhận việc. Trống = chưa ai nhận
  assignee    User?            @relation("CleaningAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById Int?
  createdBy   User?            @relation("CleaningCreator", fields: [createdById], references: [id], onDelete: SetNull)
  startedAt   DateTime? // Lúc bấm "Bắt đầu"
  completedAt DateTime? // Lúc bấm "Hoàn thành" / "Hủy"
  resultNote  String? // Ghi chú khi xong (vd "đã báo kho hết giấy") hoặc lý do hủy
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@index([areaId, status])
  @@index([assigneeId])
  @@index([completedAt])
}

// ---------- KỸ THUẬT: THIẾT BỊ & SỬA CHỮA ----------
// Tài liệu: docs/22-ky-thuat-bao-tri.md. Thiết bị mặc định: src/config/equipment.js
// "Thiết bị có sự cố" = đang có phiếu sửa chữa chưa xong; "Lịch sử sửa chữa" = phiếu đã xong.

// Thiết bị trong nhà hàng: máy lạnh, tủ đông, máy sục khí hồ, bếp gas, máy phát điện...
model Equipment {
  id               Int            @id @default(autoincrement())
  name             String         @unique
  category         String // Nhóm: Điện lạnh, Hồ hải sản, Bếp, Điện nước, An toàn, Khác (config/equipment.js)
  location         String? // Vị trí, vd "Phòng VIP", "Hồ tôm hùm"
  maintenanceDays  Int? // Chu kỳ bảo trì (ngày). Trống = không bảo trì định kỳ
  lastMaintainedAt DateTime? // Lần bảo trì gần nhất. Trống = tính hạn từ ngày thêm thiết bị (createdAt)
  note             String? // Ghi chú: hãng, số điện thoại thợ bảo hành...
  sortOrder        Int            @default(0)
  isActive         Boolean        @default(true) // Tắt = ngưng sử dụng / đã thanh lý
  tickets          RepairTicket[]
  createdAt        DateTime       @default(now())
}

// 1 phiếu sửa chữa (nhân viên báo hỏng) hoặc 1 lần bảo trì định kỳ
model RepairTicket {
  id           Int            @id @default(autoincrement())
  type         RepairType     @default(REPAIR)
  title        String // vd "Máy lạnh phòng VIP chảy nước"
  description  String? // Mô tả thêm của người báo
  equipmentId  Int
  equipment    Equipment      @relation(fields: [equipmentId], references: [id])
  priority     RepairPriority @default(NORMAL)
  status       RepairStatus   @default(OPEN)
  reportedById Int?
  reportedBy   User?          @relation("RepairReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  assigneeId   Int? // Kỹ thuật nhận sửa. Trống = chưa ai nhận
  assignee     User?          @relation("RepairAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  waitingNote  String? // Đang chờ gì (linh kiện, thợ hãng...) khi ở trạng thái WAITING_PARTS
  resolution   String? // Cách xử lý khi xong (bắt buộc) hoặc lý do hủy
  cost         Int? // Chi phí (VNĐ): linh kiện, thuê thợ. Trống = không tốn tiền
  startedAt    DateTime? // Lúc bấm "Nhận sửa"
  completedAt  DateTime? // Lúc xong / hủy
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([equipmentId, status])
  @@index([assigneeId])
  @@index([reportedById])
  @@index([completedAt])
}
