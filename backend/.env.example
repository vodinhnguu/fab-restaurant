# Cổng chạy server
PORT=4000
NODE_ENV=development

# Chuỗi kết nối PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fab_restaurant?schema=public"

# Khóa bí mật để ký JWT - hãy đổi thành chuỗi ngẫu nhiên dài khi deploy
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Địa chỉ frontend được phép gọi API (CORS), nhiều địa chỉ cách nhau bởi dấu phẩy
CORS_ORIGIN="http://localhost:5173"

# Phí giao hàng mặc định (VNĐ) và mức miễn phí giao hàng
SHIPPING_FEE=20000
FREE_SHIPPING_MIN=500000

# ----- VNPay (thanh toán online) - xem docs/11-thanh-toan-vnpay.md -----
# Bỏ trống 2 dòng đầu thì web chỉ nhận tiền mặt (ẩn lựa chọn thanh toán online)
# Đăng ký sandbox miễn phí: https://sandbox.vnpayment.vn/devreg/
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_RETURN_URL="http://localhost:5173/payment/vnpay-return"
